# Copy to paths.env and adjust for your machine
# source config/paths.env

export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export VLA_PATH="${PROJECT_ROOT}/checkpoints/bitvla-bf16"
export DATA_ROOT="${PROJECT_ROOT}/data/modified_libero_rlds"
export RUN_ROOT="${PROJECT_ROOT}/runs"

# Training
export NPROC=4
export MAX_STEPS=10001

# HuggingFace mirror (optional, China)
export HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"
